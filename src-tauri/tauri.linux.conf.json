{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "targets": ["deb"],
    "resources": {
      "resources/bin/ffmpeg": "bin/ffmpeg",
      "resources/licenses/FFmpeg.txt": "licenses/FFmpeg.txt",
      "resources/ffmpeg-manifest.json": "ffmpeg-manifest.json"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "gstreamer1.0-libav",
          "gstreamer1.0-vaapi"
        ],
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/share/metainfo/com.dohc.viewer.metainfo.xml": "../packaging/linux/com.dohc.viewer.metainfo.xml"
        }
      }
    }
